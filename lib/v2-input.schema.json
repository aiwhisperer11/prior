{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "locator",
        "publisher",
        "fragment",
        "event_timestamp",
        "recorded_at",
        "retrieval_time",
        "content_hash",
        "observation_capability",
        "entity",
        "variable",
        "observed_value",
        "units",
        "quality",
        "limitations",
        "kind"
      ],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "fragment": { "type": "string", "minLength": 1 },
        "event_timestamp": { "type": ["string", "null"] },
        "recorded_at": { "type": "string", "minLength": 1 },
        "retrieval_time": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "minLength": 1 },
        "observation_capability": { "type": "string" },
        "chain_of_custody": { "type": "string" },
        "entity": { "type": "string", "minLength": 1 },
        "variable": { "type": "string", "minLength": 1 },
        "observed_value": { "type": "string" },
        "units": { "type": ["string", "null"] },
        "quality": { "type": "string" },
        "limitations": { "type": "string" },
        "kind": { "enum": ["observed", "declared", "inferred"] }
      }
    },
    "causalChainStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "prerequisite_step",
        "expected_event",
        "actual_observation",
        "status",
        "source",
        "hypotheses",
        "detection_opportunity",
        "coverage"
      ],
      "properties": {
        "step_id": { "type": "string", "minLength": 1 },
        "prerequisite_step": { "type": ["string", "null"] },
        "expected_event": { "type": "string", "minLength": 1 },
        "actual_observation": { "type": ["string", "null"] },
        "status": {
          "enum": [
            "observed",
            "not_checked",
            "unobservable",
            "expected_but_absent",
            "occurred_but_ineffective",
            "unknown_due_to_telemetry_gap"
          ]
        },
        "source": { "type": "string", "minLength": 1 },
        "hypotheses": { "type": "array", "items": { "type": "string" } },
        "detection_opportunity": { "type": "boolean" },
        "coverage": { "enum": ["sufficient", "insufficient"] }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_mode", "case_id", "original_question", "observed_phenomenon", "causal_chain"],
      "properties": {
        "input_mode": { "const": "prestructured_chain" },
        "case_id": { "type": "string", "minLength": 1 },
        "original_question": { "type": "string", "minLength": 1 },
        "observed_phenomenon": { "type": "string", "minLength": 1 },
        "causal_chain": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/causalChainStep" } },
        "parent_snapshot_id": { "type": ["string", "null"] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_mode", "case_id", "original_question", "observed_phenomenon", "evidence_package"],
      "properties": {
        "input_mode": { "const": "source_evidence" },
        "case_id": { "type": "string", "minLength": 1 },
        "original_question": { "type": "string", "minLength": 1 },
        "observed_phenomenon": { "type": "string", "minLength": 1 },
        "evidence_package": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceEvidence" } },
        "parent_snapshot_id": { "type": ["string", "null"] }
      }
    }
  ]
}
